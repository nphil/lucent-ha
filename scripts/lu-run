#!/bin/sh
# Runs a heavy local command (tsc, esbuild, node --test, node dev/*.mjs) the way the host rules require:
# one at a time across every lucent-ha agent (flock), lowest CPU priority (nice 15, idle I/O), 4 GiB address-space cap,
# 1 GiB Node heap cap. --disable-wasm-trap-handler: Node's TypeScript stripper is WebAssembly, whose guard-region
# reservation does not fit in the 4 GiB cap.
exec flock /tmp/lucent-ha-heavy.lock nice -n 15 ionice -c3 prlimit --as=4294967296 env NODE_OPTIONS="--max-old-space-size=1024 --disable-wasm-trap-handler" "$@"
